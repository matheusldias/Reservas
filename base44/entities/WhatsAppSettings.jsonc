{
  "name": "WhatsAppSettings",
  "type": "object",
  "properties": {
    "whatsapp_number": {
      "type": "string",
      "description": "N\u00famero do WhatsApp compartilhado entre as lojas, somente d\u00edgitos com DDI (ex: 5547999999999)"
    },
    "template_name": {
      "type": "string",
      "default": "confirmacao_reserva",
      "description": "Nome do template utility aprovado na Meta para confirma\u00e7\u00e3o de reserva"
    },
    "app_url": {
      "type": "string",
      "description": "URL p\u00fablica do app, usada nos links enviados por WhatsApp"
    }
  },
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "app_role": "gerente"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "app_role": "gerente"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}