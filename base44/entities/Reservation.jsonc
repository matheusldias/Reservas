{
  "name": "Reservation",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "customer_phone": {
      "type": "string",
      "description": "Telefone do cliente"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data da reserva"
    },
    "time": {
      "type": "string",
      "description": "Hor\u00e1rio da reserva (HH:MM)"
    },
    "party_size": {
      "type": "number",
      "description": "N\u00famero de pessoas"
    },
    "dining_room_id": {
      "type": "string",
      "description": "ID do sal\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "aguardando",
        "confirmada",
        "sentada",
        "cancelada",
        "no_show"
      ],
      "default": "aguardando",
      "description": "Status da reserva"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "customer_name",
    "date",
    "time",
    "party_size"
  ]
}