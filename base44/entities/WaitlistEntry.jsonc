{
  "name": "WaitlistEntry",
  "type": "object",
  "properties": {
    "restaurant_id": {
      "type": "string",
      "description": "ID do restaurante"
    },
    "customer_name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "customer_phone": {
      "type": "string",
      "description": "Telefone do cliente"
    },
    "party_size": {
      "type": "number",
      "description": "N\u00famero de pessoas"
    },
    "status": {
      "type": "string",
      "enum": [
        "aguardando",
        "chamado",
        "sentado",
        "removido"
      ],
      "default": "aguardando",
      "description": "Status na fila"
    },
    "position": {
      "type": "number",
      "description": "Posi\u00e7\u00e3o na fila"
    }
  },
  "required": [
    "customer_name",
    "party_size"
  ]
}